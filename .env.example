# Which src/config/<NODE_ENV>.json the logger loads. Use "app" for normal running.
NODE_ENV=app

# Setlist.fm API key. Request one at https://www.setlist.fm/settings/api
# The setlist.fm API is free for non-commercial use only.
SETLISTFM_API_KEY=

# Contact detail embedded in the User-Agent sent to MusicBrainz, which their
# policy requires. An email address or a project URL. Falls back to the repo
# URL if left blank, but setting it is better manners.
# e.g. MUSICBRAINZ_CONTACT=you@example.com
MUSICBRAINZ_CONTACT=

# Optional rate limit and timeout overrides. The defaults are deliberately
# conservative: setlist.fm publishes no numbers, and community reports put the
# standard tier at roughly 2 requests/second and 1440/day. These stay well inside
# that. Note the daily limit is per-process and resets when the server restarts,
# so it is a runaway-loop circuit breaker, not a real daily quota.
# SETLISTFM_MIN_INTERVAL_MS=1100
# SETLISTFM_DAILY_LIMIT=1300
# MUSICBRAINZ_MIN_INTERVAL_MS=1100
# HTTP_TIMEOUT_MS=10000
# HTTP_MAX_ATTEMPTS caps total attempts per request, including retries on 429/502/503/504.
# HTTP_MAX_ATTEMPTS=4
